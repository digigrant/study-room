#!/usr/bin/env bash
# Study Room host command. Runs from this trusted checkout on the host; the
# checkout is never mounted into the sandbox. Docker Sandboxes calls
# `<absolute path>/bin/study-room resolve <name>` for command-backed secrets,
# so this script must work from any working directory and environment.
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
python=${STUDY_ROOM_PYTHON:-python3}
if ! "$python" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
  echo "study-room: missing host prerequisite: Python 3.12 or newer is required" >&2
  exit 10
fi
exec env PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" PYTHONDONTWRITEBYTECODE=1 "$python" -m studyroom "$@"
